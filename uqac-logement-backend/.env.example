DB_HOST=localhost
DB_PORT=5432
DB_USER=uqac
DB_PASSWORD=uqac_password
DB_NAME=uqac_logement

JWT_SECRET=change_moi_en_production

# Envoi de courriels (mot de passe oublié) — voir README pour la config Resend.
# Sans clé, le lien de réinitialisation s'affiche dans les logs du serveur.
RESEND_API_KEY=
RESEND_FROM_EMAIL=UQAC Logement <onboarding@resend.dev>

# Adresse de ton frontend, utilisée pour construire le lien de réinitialisation
FRONTEND_URL=http://localhost:3002

PORT=3000
